# Copy to factory/.env, fill in, then `source .env` before running the factory.
# Agents inherit these. Use STAGING credentials only: a Neon branch and R2 buckets made for this build.

# Database: Neon, staging branch, PostGIS enabled (CREATE EXTENSION postgis; the migrations also do it)
export DATABASE_URL="postgres://USER:PASSWORD@HOST/marden_staging?sslmode=require"

# Cloudflare R2 (buckets: marden-raw, marden-snapshots, marden-backups; created by the infra task if missing)
export R2_ACCOUNT_ID=""
export R2_ACCESS_KEY_ID=""
export R2_SECRET_ACCESS_KEY=""

# Railway: account or team token with access to a project for Marden staging
export RAILWAY_TOKEN=""

# SEC EDGAR requires a declared User-Agent with a contact address
export SEC_USER_AGENT="Marden research cody@marden.ai"

# Clerk: DEVELOPMENT instance for staging (Dashboard -> API keys); webhook secret from Dashboard -> Webhooks
export CLERK_PUBLISHABLE_KEY=""          # pk_test_...
export NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="$CLERK_PUBLISHABLE_KEY"
export CLERK_SECRET_KEY=""               # sk_test_...
export CLERK_WEBHOOK_SIGNING_SECRET=""   # whsec_...

# Legacy code + data unzipped together (bootstrap.sh prints this path)
export MARDEN_SEED_DIR=""

# Claude: an API key with high rate limits (needed for ~48 concurrent agents). Leave empty only if `claude` is logged in.
export ANTHROPIC_API_KEY=""

# Optional: features run in stub mode without them
export POSTMARK_TOKEN=""
export FRED_API_KEY=""
export MARKET_DATA_API_KEY=""
export SENTRY_DSN=""
export GITHUB_REMOTE=""      # e.g. git@github.com:marden/marden.git; main is pushed when the run ends
