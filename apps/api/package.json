{
  "name": "@marden/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marden internal API: serves /api/* from read_model and live updates from stream_event",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "3.23.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "svix": "2.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "jose": "6.2.12",
    "tsx": "4.23.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
