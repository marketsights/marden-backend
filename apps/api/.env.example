# apps/api environment. Copy to your shell or Railway variables; never commit real values.
NODE_ENV=development
DATABASE_URL=postgres://marden:marden@localhost:5432/marden?sslmode=disable
# dev = one local owner + staff user in org "dev" (refused when NODE_ENV=production); clerk = real sessions
MARDEN_AUTH_MODE=dev
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Optional PEM public key for networkless token verification (newlines as \n)
CLERK_JWT_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Comma-separated web origins allowed by CORS and as the token's authorized party
WEB_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MINUTE=600
STREAM_HEARTBEAT_MS=25000
STREAM_RECHECK_MS=600000
TRUST_PROXY=false
LOG_LEVEL=info
HOST=0.0.0.0
PORT=4000
