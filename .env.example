# Marden environment. Copy to .env (never committed) and fill in; every value here is a default or blank.
# Read by services/marden/core/config.py (Python) and apps/api (Node). Missing credentials never
# produce stand-in data: the affected source records the failure on its `source` row instead.

# ---------------------------------------------------------------- database
# Postgres 16 + PostGIS. Local development (scripts/dev-setup.sh creates it):
#   postgres://marden:marden@localhost:5432/marden?sslmode=disable
# Staging/production: the Neon connection strings (sslmode=require), as `neon env pull` writes them:
#   DATABASE_URL           pooled endpoint (-pooler host): the API's queries
#   DATABASE_URL_UNPOOLED  direct endpoint: migrations, the Python workers and queue, the API's
#                          LISTEN for the live stream (PgBouncer's transaction mode drops LISTEN)
# Leave DATABASE_URL_UNPOOLED blank locally; everything then uses DATABASE_URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------- raw document store
# Local raw store used when R2 credentials are absent. Default: <repo>/.raw (gitignored).
MARDEN_RAW_DIR=
# Cloudflare R2 (S3 API at https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com). All three keys
# switch the raw store from MARDEN_RAW_DIR to R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Buckets (owner decision: core-raw, core-snapshots, core-backups). Raw fetched files. Default: core-raw
R2_BUCKET_RAW=core-raw
# Nightly pg_dump archives (marden.core.backup; without R2 the backup records "not configured"). Default: core-backups
R2_BUCKET_BACKUPS=core-backups

# ---------------------------------------------------------------- collection
# Declared User-Agent for sec.gov (SEC fair-access policy requires a contact address).
SEC_USER_AGENT=Marden research cody@marden.ai
# FRED API key (Treasury and SOFR curves). Without it the FRED collector records a missing credential.
FRED_API_KEY=
# FINRA API client credentials (TRACE bond trades, when licensed).
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
# ERCOT Public API (https://apiexplorer.ercot.com, free registration by a person; ERCOT does not permit
# bot-registered accounts): the Primary subscription key from your Public API product subscription and
# the account's email and password (exchanged for a one-hour ID token on each run). Without all three
# the ERCOT GIS collector records "needs key" and makes no request. robots.txt disallows the MIS
# download paths on www.ercot.com, so the API is the only automated route to the GIS report.
ERCOT_API_KEY=
ERCOT_API_USERNAME=
ERCOT_API_PASSWORD=
# Serve and use prices from sources Marden collects without a commercial licence (finra.org TRACE,
# Börse Frankfurt, Yahoo Finance; services/marden/core/licensing.py, docs/methods/licensing.md).
# true (default) or false. false hides every row whose source_name is flagged unlicensed-commercial.
MARDEN_SHOW_UNLICENSED_PRICES=true

# ---------------------------------------------------------------- extraction
# Claude API key for the extraction and verifier agents.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- seed data
# Directory holding the unzipped marden_data_2026-10-20.zip for `python -m marden seed <loader>`.
MARDEN_SEED_DIR=

# ---------------------------------------------------------------- API (apps/api; spec 23)
# development | production. Production refuses MARDEN_AUTH_MODE=dev and requires the Clerk keys.
NODE_ENV=development
# clerk (default) | dev (one local owner+staff user in org `dev`; local development only)
MARDEN_AUTH_MODE=clerk
# Clerk instance keys (Dashboard -> API keys); the web app uses the same publishable key.
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk webhook signing secret (Dashboard -> Webhooks).
CLERK_WEBHOOK_SIGNING_SECRET=
# Optional PEM public key for networkless session-token verification.
CLERK_JWT_KEY=
# Web origin allowed as the token's authorized party and for CORS. Default: http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Requests per minute per client. Default: 600
RATE_LIMIT_PER_MINUTE=600
# SSE heartbeat and session re-check intervals (ms). Defaults: 25000 and 600000
STREAM_HEARTBEAT_MS=25000
STREAM_RECHECK_MS=600000
# Logging and listener. Defaults: info, false, 0.0.0.0, 4000
LOG_LEVEL=info
TRUST_PROXY=false
HOST=0.0.0.0
PORT=4000

# ---------------------------------------------------------------- deploy and operations (docs/DEPLOY.md)
# On Railway set TRUST_PROXY=1 (one proxy hop: Railway's edge) and PORT=4000 explicitly.
# API: how long SIGTERM waits for in-flight requests before exiting (ms; keep below Railway's
# drainingSeconds, 30 s in apps/api/railway.json). Default: 20000
SHUTDOWN_TIMEOUT_MS=20000
# Worker: seconds running jobs get after SIGTERM (keep below drainingSeconds, 120 s in
# services/railway.json). Default: 90
MARDEN_WORKER_SHUTDOWN_TIMEOUT=90
# Python log format: text (default) or json (the worker image sets json); secrets are redacted either way.
MARDEN_LOG_FORMAT=text
MARDEN_LOG_LEVEL=INFO
# scripts/migrate.sh (marden-migrate): wait for the database / for a concurrent migration's lock.
# Defaults: 60s and 10m
MARDEN_MIGRATE_WAIT=60s
MARDEN_MIGRATE_LOCK_TIMEOUT=10m
